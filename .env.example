# Pooled Postgres connection used by Vercel Functions and local development.
# Vercel's Supabase integration can inject POSTGRES_URL automatically.
POSTGRES_URL=

# Vercel injects BLOB_STORE_ID and a short-lived OIDC token when a private Blob
# store is connected. BLOB_READ_WRITE_TOKEN is only needed outside Vercel.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Supabase Auth public configuration. These values are safe for the browser;
# never place the Supabase service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
NEXT_PUBLIC_ENABLE_GUEST_DEMO=false

# Production analysis uses a server-only OpenAI key. Never expose it publicly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Enabling this makes user-initiated analysis requests billable.
OPENAI_ANALYSIS_ENABLED=true
