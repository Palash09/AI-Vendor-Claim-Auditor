# Netlify Database is injected automatically in deploys and `netlify dev`.
# Set this only when connecting to an existing local or remote Postgres database.
NETLIFY_DB_URL=

# Supabase Auth public configuration. These values are safe for the browser;
# never place the Supabase service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Optional: omit the API key to use the conservative local demo analyzer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
